<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.namo.cam</string>

    <!-- 로그인하면 카메라 스트림을 띄우고, 죽으면 되살립니다.

         macOS 카메라·마이크 권한은 로그인 세션(gui 도메인)의 LaunchAgent
         에서도 받을 수 있습니다. SSH로 띄울 때와 달리 권한 창이 화면에
         뜨므로, 처음 한 번 허용을 누르면 그 뒤로는 재부팅해도 스스로
         뜹니다. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kdh/project/namo-firmware/scripts/cam.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/kdh/project/namo-firmware</string>

    <!-- ffmpeg는 homebrew에 있습니다. launchd의 기본 PATH에는 없습니다. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <!-- cam.sh는 ffmpeg가 얼거나 죽으면 스스로 다시 띄웁니다. 이것은
         cam.sh 자체가 끝났을 때를 위한 것입니다. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/Users/kdh/Library/Logs/namo-cam.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kdh/Library/Logs/namo-cam.log</string>
</dict>
</plist>
